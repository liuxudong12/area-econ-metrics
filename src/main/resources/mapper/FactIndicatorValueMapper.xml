<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ⚠️ namespace 必须一字不差地等于 Mapper 接口的全限定名。
     写错 = 启动时报 "Invalid bound statement (not found)"，这是新手第一大坑。
-->
<mapper namespace="com.liuxudong.areaecon.mapper.FactIndicatorValueMapper">

    <!--
      按指标分类汇总各区域的值（大屏最典型的查询）

      ⚠️ Day 6 改造：这里**去掉了 JOIN dim_region**，只 JOIN dim_indicator。
         区域名称改由 Service 层批量查一次补上（见 StatServiceImpl.categorySummary）。

      【改造前 vs 改造后 —— 一条 SQL 的两种写法，差 4.6 倍】
        ✗ 改造前（44.3 ms）：
            JOIN dim_region 写在里面 → MySQL 的执行顺序是
            1350 行明细 → 每行都去 dim_region 换区域名（1350 次随机回表）→ 再聚合压成 150 行
        ✓ 改造后（9.52 ms）：
            1350 行明细 → 先聚合压成 150 行 → 只补 150 个区域名（150 次查询）

        一句话原理：**聚合会砍掉 90% 的行，那就该让它先发生。**
        把维表关联推迟到聚合之后，回表次数从 1350 降到 150。

      【EXPLAIN ANALYZE 实测（MySQL 8.0.46，同一台机器）】
        改造前：Nested loop inner join  (actual time=0.273..42.8)   ← 42.8ms 全花在这
        改造后：Index range scan on f using idx_tpi (actual time=0.336..7.84)  ← 7.8ms 扫完
        两者返回的 totalValue 前五名一字不差（已校验）。

      【逐段解释】
        SELECT ... AS regionCode
          给列起别名。别名要和 VO 的字段名对上，否则接不到值（而且不报错，只是 null）。
        FROM fact_indicator_value f
          主表：指标值事实表（49 万行，慢就慢在它）。
          改造后走 idx_tpi 索引做 range 扫描，只碰 5,418 行。
        JOIN dim_indicator i ON i.indicator_code = f.indicator_code
          关联指标维表，才能按 category（分类）过滤。
          它只有 18 行，全表扫 + hash join 是**最优解**，不用为它优化。
        WHERE f.deleted = 0 AND i.deleted = 0
          ⚠️ 手写 SQL 时，逻辑删除条件必须**自己加**！
             这跟 MyBatis-Plus 自动生成的单表查询不一样——
             它只认实体上的 @TableLogic，你手写的 SQL 它管不了。
             **忘了加 = 把已删除的数据也算进统计里**，这是非常典型的线上事故。
             （你之前修过的"统计数量和清单对不上"，很多就是这类问题）
        GROUP BY f.region_code
          只按编码分组 —— 改造前这里还要带上 r.region_name，
          因为 SELECT 里的非聚合列必须出现在 GROUP BY 里（ONLY_FULL_GROUP_BY 模式的要求）。
          现在不关联区域表了，自然也不用按名字分组。
        ORDER BY totalValue DESC
          按别名排序，最大的在前。

      【#{} 和 ${} 的区别（面试高频）】
        #{}  预编译占位符 → JDBC 的参数绑定 → 能防 SQL 注入   ← 我们全程用这个
        ${}  字符串直接拼接 → 有注入风险 → 只在拼表名/字段名时才用

      【⚠️ 改造 SQL 时最容易翻车的不是语法，是边界语义】
        改造前 `JOIN dim_region ... AND r.deleted = 0` 隐含一条规则：
        **被逻辑删除的区域不会出现在结果里**。
        改造后这条 SQL 会把已删除区域也聚合出来（因为没人拦它了）。
        所以 Service 侧补名字时，**Map 里找不到对应区域的记录会被丢弃** ——
        这样才和原语义等价。改写 SQL 时一定要问自己：
        "原来的那些 JOIN / WHERE，除了过滤数据，还偷偷承担了什么语义？"
    -->
    <select id="selectCategorySummary"
            resultType="com.liuxudong.areaecon.controller.vo.RegionMetricStatVO">
        SELECT f.region_code          AS regionCode,
               SUM(f.indicator_value) AS totalValue
        FROM fact_indicator_value f
                 JOIN dim_indicator i ON i.indicator_code = f.indicator_code
        WHERE f.deleted = 0
          AND i.deleted = 0
          AND f.period_type = #{periodType}
          AND i.category = #{category}
          AND f.period_code IN
        <foreach collection="periodCodes" item="pc" open="(" separator="," close=")">
            #{pc}
        </foreach>
        GROUP BY f.region_code
        ORDER BY totalValue DESC
    </select>

    <!--
      ★ Day 5 已治好的"慢查询" ★

      按周期汇总某分类的值（大屏趋势折线图）。

      优化前：type=ALL, key=NULL, rows=487354，DB 耗时 133.45 ms（全表扫 48 万行）
      优化后：type=range, key=idx_tpi, rows=5400，DB 耗时 9.66 ms
      改动：  ALTER TABLE fact_indicator_value
                ADD INDEX idx_tpi (period_type, period_code, indicator_code);

      ⚠️ 关键：这条 SQL 一个字都没改，只补了个索引就快了 13.8 倍。
         "优化 SQL" 和 "优化索引" 是两回事，你在 Day 5 / Day 6 各碰到一种：
           · selectPeriodTrend     → 加索引   （问题是"扫描的行太多"）
           · selectCategorySummary → 改结构   （问题是"回表次数太多"）
         面试时能讲清这两种的区别，说明你是真在做优化，而不是套模板背答案。

      它和上面那条 SQL 的唯一区别：SELECT / GROUP BY 里**没有 region_code**。
      结果就是 uk_fact 索引用不上（最左列缺失），只能全表扫描 48 万行。

      到时候你会：
        ① 先执行这段 SQL，用 EXPLAIN 记下 type / key / rows
        ② 测出耗时（实测约 123ms）
        ③ 加索引：ALTER TABLE fact_indicator_value
                   ADD INDEX idx_type_period_indicator (period_type, period_code, indicator_code, region_code);
        ④ 再跑一遍，看 type 变成 range、耗时掉到个位数毫秒

      那组前后对比数字，就是你简历上"索引优化"那一条。
    -->
    <select id="selectPeriodTrend"
            resultType="com.liuxudong.areaecon.controller.vo.PeriodMetricStatVO">
        SELECT f.period_code        AS periodCode,
               SUM(f.indicator_value) AS totalValue
        FROM fact_indicator_value f
                 JOIN dim_indicator i ON i.indicator_code = f.indicator_code
        WHERE f.deleted = 0
          AND i.deleted = 0
          AND f.period_type = #{periodType}
          AND i.category = #{category}
          AND f.period_code IN
        <foreach collection="periodCodes" item="pc" open="(" separator="," close=")">
            #{pc}
        </foreach>
        GROUP BY f.period_code
        ORDER BY f.period_code
    </select>

    <!--
      ============ Day 6 新增 · 大屏"排行榜" TOP N ============

      需求：某分类、某周期下，各区域按总值排名，取前 N 名，还要给出名次和占比。

      【核心：窗口函数 Window Function】
        RANK() OVER (ORDER BY t.totalValue DESC)                  → 名次
        SUM(t.totalValue) OVER ()                                 → 所有区域的总值
        ROUND(t.totalValue / SUM(t.totalValue) OVER () * 100, 2)  → 占比(%)

      「OVER ()」括号里什么都不写 = 把整个结果集当成一个窗口来算。
      这跟 GROUP BY 是**两码事**，区别必须搞清（面试常问）：
        GROUP BY  → 把多行**压成一行**，结果行数变少（150 行 → 150 个区域，只是明细没了）
        窗口函数  → **不改行数**，只是给每一行额外挂一列计算结果

      所以"分组汇总之后，我还想同时看到组内明细 / 与整体的对比"，就用窗口函数。

      【为什么外面要套一层子查询 t？】
        MySQL 的执行顺序是：FROM → WHERE → GROUP BY → HAVING → SELECT → ORDER BY
        SELECT 里的聚合结果（SUM(...) AS totalValue）在同一层的窗口函数里**不能直接引用**。
        所以：先在子查询里把"每个区域的总值"算出来，外层再把 t 当成一张普通表做窗口计算。
        经验：**窗口函数套在聚合结果之上时，套子查询是最省心的写法。**

      【RANK / DENSE_RANK / ROW_NUMBER 三兄弟（必考）】
        假设三个区域的值是 100 / 100 / 90：
          ROW_NUMBER()   → 1, 2, 3    不管值是否相同，就是硬编号
          RANK()         → 1, 1, 3    并列占名次，后面**跳号**
          DENSE_RANK()   → 1, 1, 2    并列占名次，后面**不跳号**
        这里选 RANK()：业务上"并列第 1 名，下一名是第 3 名"符合排行榜的直觉。

      【LIMIT #{topN} 的一个认知点】
        LIMIT 是**最后**才生效的。它不会让 MySQL 少干活——
        150 个区域该聚合还得全聚合完、该排序还得全排完，只是最后只吐 10 行出来。
        所以"加 LIMIT 就变快"是错觉；真要让数据库少干活，得在 WHERE 上做文章。
    -->
    <select id="selectTopRegions"
            resultType="com.liuxudong.areaecon.controller.vo.RegionRankVO">
        SELECT t.regionCode,
               t.totalValue,
               RANK() OVER (ORDER BY t.totalValue DESC)                 AS rankNo,
               ROUND(t.totalValue / SUM(t.totalValue) OVER () * 100, 2) AS share
        FROM (
                 SELECT f.region_code          AS regionCode,
                        SUM(f.indicator_value) AS totalValue
                 FROM fact_indicator_value f
                          JOIN dim_indicator i ON i.indicator_code = f.indicator_code
                 WHERE f.deleted = 0
                   AND i.deleted = 0
                   AND f.period_type = #{periodType}
                   AND i.category = #{category}
                   AND f.period_code IN
                 <foreach collection="periodCodes" item="pc" open="(" separator="," close=")">
                     #{pc}
                 </foreach>
                 GROUP BY f.region_code
             ) t
        ORDER BY t.totalValue DESC
        LIMIT #{topN}
    </select>

    <!--
      ============ Day 6 新增 · 同比增长 YoY ============

      需求：某分类下，每个区域"当期值 vs 基期值"，以及增长额、增长率。

      【核心：条件聚合 Conditional Aggregation】
        两个 SUM，长的几乎一样，只差 case when 里的条件：

          SUM(CASE WHEN f.period_code = '2025' THEN f.indicator_value ELSE 0 END)  → 当期值
          SUM(CASE WHEN f.period_code = '2024' THEN f.indicator_value ELSE 0 END)  → 基期值

        拆开看它在干嘛：
          SUM(   CASE WHEN 周期 = 当期  THEN 值  ELSE 0  END   )
          ↑      └──────── 只挑出"这一档"的值，别的都当 0 ────────┘
          然后把这批值加起来

        **一次扫表，同时算出多个口径** —— 这是数据统计里最常用的手法之一。

      【为什么不查两次库？】
        两个值来自同一批数据、同一个 WHERE、同一次扫描，只是"分档"不同。
        分两次查的代价：两倍 I/O、两倍网络往返，而且回到 Java 还得按 region_code 把两边拼起来，
        某个区域一边有一边没有时很容易对不齐。**能用一条 SQL 算完的，别拆成两条。**

      【⚠️ ELSE 0 千万别省】
        不写 ELSE 时 CASE 返回 NULL，SUM 里混进 NULL 虽然不会算错（SUM 会跳过 NULL），
        但语义就变模糊了：你分不清"这个区域当期真的是 0"和"当期压根没数据"。
        写 ELSE 0 表达的是"**没数据视作 0**"，这是明确的口径声明。
        真实项目里这个区别很要命 —— 财务口径对不上，往往就差在这。

      【索引用得怎么样】
        period_type = ? 是等值，period_code IN (?, ?) 是范围，正好是
        idx_tpi(period_type, period_code, indicator_code) 的最左两列 → 走 range 扫描。
        这就是 Day 5 那个索引的"副产品价值"：**新写的统计 SQL 也自动沾光了**。
        这说明索引设计要考虑的是"这一类查询"，而不是"这一条查询"。

      【增长额和增长率为什么不在这里算？】
        放在 Service 层用 BigDecimal 算。理由：SQL 只管取数，业务计算交给 Java，
        以后换数据库 / 换写法都不用重写业务逻辑。而且除零、精度、舍入这三件事在 SQL 里更不好控制。
    -->
    <select id="selectRegionYoy"
            resultType="com.liuxudong.areaecon.controller.vo.RegionYoyVO">
        SELECT f.region_code AS regionCode,
               SUM(CASE WHEN f.period_code = #{currentPeriod} THEN f.indicator_value ELSE 0 END) AS currentValue,
               SUM(CASE WHEN f.period_code = #{basePeriod} THEN f.indicator_value ELSE 0 END)    AS baseValue
        FROM fact_indicator_value f
                 JOIN dim_indicator i ON i.indicator_code = f.indicator_code
        WHERE f.deleted = 0
          AND i.deleted = 0
          AND f.period_type = #{periodType}
          AND i.category = #{category}
          AND f.period_code IN (#{currentPeriod}, #{basePeriod})
        GROUP BY f.region_code
        ORDER BY f.region_code
    </select>
    <!--
      ==================== Day 9：批量插入 ====================

      这条 SQL 长这样（假设 list 里有 3 条）：
        INSERT INTO fact_indicator_value
            (region_code, indicator_code, period_code, period_type, indicator_value, data_source)
        VALUES
            ('430102', '2-1', '2027-01', 'M', 1234.5000, '导入'),
            ('430102', '2-2', '2027-01', 'M',  567.0000, '导入'),
            ('430102', '2-3', '2027-01', 'M',  890.1200, '导入')

      【<foreach> 的三个关键属性】
        collection="list"  要遍历的集合。Mapper 方法用了 @Param("list")，所以写 list。
                           （如果不写 @Param，MyBatis 对单个 List 参数默认名是 list / collection，
                             都能用，但这属于"靠默认值"，建议永远显式 @Param。）
        item="item"        循环变量名，下面 #{item.xxx} 用它取值。
        separator=","      每个元素之间用什么分隔 —— 这里必须是逗号，
                           拼成 VALUES (...), (...), (...) 的形式。

      【为什么 values 里没有 id / create_time / update_time / deleted】
        - id：自增，不用给
        - create_time / update_time：表定义里 DEFAULT CURRENT_TIMESTAMP，数据库自动填
        - deleted：DEFAULT 0，自动填
      只给"业务字段"赋值，这是插入语句的常规做法。

      【⚠️ 空列表会拼出非法 SQL】
        如果 list 是空集合，<foreach> 什么都不产出，SQL 变成：
            INSERT INTO fact_indicator_value (...) VALUES
        结尾挂着 VALUES 却没有值 → 直接语法错误。
        **调用方必须先判空**（Service 里做了）。

      【⚠️ 批量插入不走 MyBatis-Plus 的 @TableLogic】
        deleted 字段这里不写，靠数据库默认值 0，没有问题。
        但记住这条规律：凡是手写 SQL，逻辑删除条件都得自己管。
    -->

    <!--
      ==================== Day 10：从"插入"升级为"重入" ====================

      【问题：一条 INSERT，让"重试"变成永远不可能成功】

        假设导入 1 万行、每 500 行一批，共 20 批。跑到第 11 批时数据库连接断了：
            第 1~10 批已提交 → 5000 行躺在表里
            第 11 批抛异常     → 任务 FAILED，success_rows=5000

        此时用户点"重试"，如果还是纯 INSERT：
            第 1 批 → 前 500 行里有一部分一定撞 uk_fact(region_code, indicator_code, period_code)
                   → 整批 500 行全部回滚 → 又失败 → 又重试 → 又失败
        死循环。**这个文件永远导不进去。**

      【解法：ON DUPLICATE KEY UPDATE —— 把"重复"从错误变成正常分支】

        INSERT ... ON DUPLICATE KEY UPDATE 的语义是：
            能插就插；撞了唯一索引就**改成执行后面的 UPDATE**。
        所以同一份数据跑 1 遍和跑 100 遍，结果完全一样 —— 这叫**幂等**。

        这就是那句话的出处：
            **"可重试"的前提是"可重入"。**
        不可重入的操作（纯 INSERT、扣库存、发短信）套上重试框架，
        只会把"失败一次"变成"失败四次"，还把问题放大。

      【SET 子句里每一项为什么这么写】

        period_type = VALUES(period_type)
            period_type 不在 uk_fact 里（uk 只有 region/indicator/period_code），
            说明它是"冗余描述字段"。重复导入时以**最后一次**为准，跟着更新。

        indicator_value = VALUES(indicator_value)
            这一条是 upsert 的真正意义：数据修正后重新导入，值会被覆盖。
            （如果业务要求"导入的历史值不许改"，这里就必须去掉这一行，
              或者加 AND indicator_value IS NULL，那是另一种语义，想清楚再定。）

        data_source = VALUES(data_source)
            同上，标记这行最后一次是"导入"来的。

        deleted = 0    ★ 这一行最容易漏，而且漏了是"静默错误"
            唯一索引 uk_fact **不包含 deleted 字段**。
            所以一行被逻辑删除后（deleted=1），它的唯一键还占着位置。
            再来导入同一组 (region, indicator, period) 会撞索引 → 走 UPDATE 分支。
            如果 SET 里不写 deleted=0，这行就**永远保持 deleted=1** ——
            SQL 不报错、接口返回成功、用户查询结果里却看不到这条数据。
            这种"不报错的错"在线上最难查。

      【⚠️ 返回值语义变了，别拿它当"写入行数"用】

        纯 INSERT 返回 500 表示插了 500 行。
        但 ON DUPLICATE KEY UPDATE 的 affected rows 是这样算的（MySQL 官方规则）：
            插入一行        → 计 1
            更新一行        → 计 2（先逻辑删除再插入，所以算两下）
            命中但值没变    → 计 0
        批量时这些数字会**混在一起累加**，你根本没法反推真实行数。
        所以 ImportServiceImpl 里的 `written` 是自己在事务提交后手数批次数，
        **不信 SQL 返回值** —— 这是个必须讲清的细节。

      【副作用：AUTO_INCREMENT 会跳号】
        每次撞索引都会消耗一个自增 id（即使走了 UPDATE 分支）。
        所以反复导入后 id 会变得不连续。这不是 bug，是 InnoDB 的固有行为，
        真实项目里也不要依赖"id 连续"做任何业务判断。

      【MySQL 8.0.19+ 的新写法】
            INSERT INTO t (...) VALUES (...) AS new
            ON DUPLICATE KEY UPDATE c = new.c
        官方已把 VALUES(col) 标为 deprecated（还能用，会出 warning）。
        这里保留 VALUES() 是为了兼容老版本 + 面试官最熟悉这种写法。
    -->
    <insert id="insertBatch">
        INSERT INTO fact_indicator_value
            (region_code, indicator_code, period_code, period_type, indicator_value, data_source)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.regionCode}, #{item.indicatorCode}, #{item.periodCode},
             #{item.periodType}, #{item.indicatorValue}, #{item.dataSource})
        </foreach>
        ON DUPLICATE KEY UPDATE
            period_type     = VALUES(period_type),
            indicator_value = VALUES(indicator_value),
            data_source     = VALUES(data_source),
            deleted         = 0
    </insert>

    <!-- ==================================================================
         Day 12：明细导出
         ==================================================================

         【★ 这段 <sql> 片段是今天的第一个技术点：条件只写一遍 ★】
         下面两个查询（计数、取数）用的过滤条件必须**完全一致**，
         否则会出现"界面说 12,000 行、导出文件只有 11,980 行"这种事，
         用户第一反应是"系统丢数据了"。

         把条件抽成 <sql id="exportWhere">，两个查询都用 <include refid="exportWhere"/> 引入 ——
         编译期就有保证，改一处全改，不会漏。

         ⚠️ f.deleted = 0 必须自己写。手写 SQL 不走 @TableLogic 的逻辑删除拦截。
    -->
    <sql id="exportWhere">
        f.deleted = 0
        <if test="query.regionCodePrefix != null and query.regionCodePrefix != ''">
            AND f.region_code LIKE CONCAT(#{query.regionCodePrefix}, '%')
        </if>
        <if test="query.indicatorCode != null and query.indicatorCode != ''">
            AND f.indicator_code = #{query.indicatorCode}
        </if>
        <if test="query.periodType != null and query.periodType != ''">
            AND f.period_type = #{query.periodType}
        </if>
        <if test="query.periodFrom != null and query.periodFrom != ''">
            AND f.period_code &gt;= #{query.periodFrom}
        </if>
        <if test="query.periodTo != null and query.periodTo != ''">
            AND f.period_code &lt;= #{query.periodTo}
        </if>
    </sql>

    <!--
      导出前的计数。

      【为什么导出前要先 COUNT 一次？】
      因为 HTTP 响应是**流式**的：一旦 setHeader + 开始写 Excel，就没法回头了。
      如果这个用户筛出来的数据有 300 万行，而你闷头开始导，
      最后要么 OOM、要么 Excel 超出行数上限、要么用户等到超时 —— 全程无法告知他"太多了"。

      正确顺序是：
        ① 先 COUNT（一条聚合 SQL，很快）
        ② 判断是否超过 max-rows → 超了就直接返回 JSON 错误
        ③ 通过校验后才 setHeader、才开始写

      代价是 "多一次 COUNT"，收益是 "永远不会有半截文件"。这笔买卖很划算。
      （COUNT(*) 在 InnoDB 上要走索引，48 万行大约几十毫秒，详见手册的实测数字。）
    -->
    <select id="countForExport" resultType="long">
        SELECT COUNT(*)
        FROM fact_indicator_value f
        WHERE <include refid="exportWhere"/>
    </select>

    <!--
      游标分页取一页（keyset pagination / 键集分页）。

      【★ 今天最重要的一个 SQL：为什么不是 LIMIT offset, size ★】

        ✗ 传统写法：
            SELECT ... FROM fact_indicator_value WHERE 条件 ORDER BY id LIMIT 400000, 2000
          语义是"先按顺序数出 40 万行，把它们全部丢掉，再取接下来的 2000 行"。
          所以**翻得越深越慢**，第 N 页的成本是 O(offset + size)。
          全量导出要翻 245 页，总成本 O(n²) —— 越往后越像卡死。

        ✓ 游标写法：
            SELECT ... FROM fact_indicator_value WHERE 条件 AND id > 上一页最后一个 id
            ORDER BY id LIMIT 2000
          语义是"直接在 B+ 树上定位到 id=400001 这个位置，往后再取 2000 行"。
          **每一页的成本都一样**，总成本 O(n)。

      【前提：排序键必须唯一且有序】
        这里用主键 id —— 自增、唯一、有索引，天然满足。
        如果业务上必须按 update_time 排序，那就要用 (update_time, id) 做联合游标，
        否则同一时刻的多条记录会漏掉或重复（这个细节面试常考）。

      【为什么 ORDER BY id 而不是 ORDER BY region_code, indicator_code】
        id 是聚簇索引（InnoDB 主键索引的叶子节点就是数据行本身），
        按 id 顺序扫描 = **顺序 I/O**，一次读一大片，预读能生效。
        按别的字段排 = 要么走二级索引再回表（随机 I/O），要么 filesort 临时表。

      【#{} 里的 limit】
        LIMIT 后面可以绑定参数（MySQL 支持），但**不能用 #{} 之外的 ${}**，
        因为 LIMIT 位置不允许参数化表达式（如 LIMIT #{a}*2 会报错）。
    -->
    <select id="selectForExportByCursor"
            resultType="com.liuxudong.areaecon.entity.FactIndicatorValue">
        SELECT f.id,
               f.region_code,
               f.indicator_code,
               f.period_code,
               f.period_type,
               f.indicator_value,
               f.data_source
        FROM fact_indicator_value f
        WHERE <include refid="exportWhere"/>
          AND f.id &gt; #{lastId}
        ORDER BY f.id
        LIMIT #{limit}
    </select>

</mapper>
